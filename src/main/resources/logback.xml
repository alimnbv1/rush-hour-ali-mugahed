<configuration>
    <!-- Logs go to a file so they do not disturb the game on the console -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>rushhour.log</file>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
